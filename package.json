{
  "name": "pdf-presenter",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "sync-version": "node scripts/sync-version.mjs",
    "dev": "node scripts/sync-version.mjs && vite",
    "build": "node scripts/sync-version.mjs && vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:build": "tauri build",
    "tauri:build:windows": "tauri build --bundles nsis",
    "tauri:build:portable": "tauri build --no-bundle && node scripts/package-portable.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "katex": "^0.19.1",
    "lucide-vue-next": "^1.0.0",
    "pdfjs-dist": "^6.4.299",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/katex": "^0.16.8",
    "@vitejs/plugin-vue": "^6.0.7",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.5"
  }
}
